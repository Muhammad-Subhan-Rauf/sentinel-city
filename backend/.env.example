DATABASE_URL=postgresql://postgres:your-password@db.xqfpsns.supabase.co:5432/postgres

# ── City Resilience Insight (admin heatmap, /api/city-insight) ──
# Requires Vertex AI creds (GOOGLE_CLOUD_PROJECT / GOOGLE_CLOUD_LOCATION /
# GOOGLE_APPLICATION_CREDENTIALS), same as the rest of the AI pipeline. If
# Vertex is unavailable the endpoint degrades gracefully to a non-AI payload.
# SENTINEL_CITY_INSIGHT_MODEL=gemini-2.5-flash
# SENTINEL_CITY_INSIGHT_TIMEOUT=20.0
