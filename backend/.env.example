# ============================================================
# Sentinel-City — Backend Environment Variables
# ============================================================
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to version control.
# ============================================================

# Direct PostgreSQL connection string
# Found in: Supabase Dashboard → Project Settings → Database → Connection string (URI)
DATABASE_URL=postgresql://postgres:your-password@db.xqfpsns.supabase.co:5432/postgres

# JWT Secret — used to verify tokens issued by Supabase Auth
# Found in: Supabase Dashboard → Project Settings → API → JWT Secret
SUPABASE_JWT_SECRET=your-jwt-secret-here
