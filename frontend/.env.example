# ============================================================
# Sentinel-City — Frontend Environment Variables
# ============================================================
# Copy this file to .env and fill in your actual values.
# ============================================================

# Backend URL (default: FastAPI local dev server)
VITE_BACKEND_URL=http://localhost:8000

# Valhalla-compatible routing service. Defaults to Stadia Maps' hosted
# Valhalla. Override if you self-host (e.g. http://localhost:8002).
VITE_VALHALLA_URL=https://api.stadiamaps.com

# Stadia Maps API key. Get one free at https://client.stadiamaps.com/signup/
# — required when VITE_VALHALLA_URL points at api.stadiamaps.com. The key
# is baked into the JS bundle (Stadia's standard client-side model).
VITE_STADIA_API_KEY=your-api-key-here
